{
  "question": "Who earns more, John Smith or James Brown?",
  "steps": [
    {"kind": "tool_call", "name": "get_salary", "arguments": {"name": "John Smith"}, "bind_result_as": "salary_john"},
    {"kind": "tool_call", "name": "get_salary", "arguments": {"name": "James Brown"}, "bind_result_as": "salary_james"},
    {"kind": "compute",
     "code_template": "result = 'John Smith' if resolve({0!r}) > resolve({1!r}) else 'James Brown'",
     "inputs_from": ["salary_john.salary", "salary_james.salary"],
     "bind_result_as": "answer_token"},
    {"kind": "final_text", "template": "The higher earner is {answer_token}."}
  ],
  "expected_final_text": "The higher earner is James Brown.",
  "leak_probes": [62000, 71000, "62000", "71000"]
}
