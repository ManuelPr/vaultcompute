{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "vaultcompute hook session-start" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "vaultcompute hook pre-tool-use" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "vaultcompute hook post-tool-use" }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          { "type": "command", "command": "vaultcompute hook message-display" }
        ]
      }
    ]
  }
}
